# Nested on purpose: the repository root's .gitignore belongs to the quotation app and is
# not this project's to edit.

# Extracted images, content-addressed. Regenerable from the source documents, and they are
# client material either way — the same reason the app upstairs keeps images/ out of git.
store/

# Readable exports and their manifest, likewise regenerable.
out/

# A virtualenv created by run.bat / run.sh for this tool alone.
venv/

__pycache__/
*.py[cod]
.pytest_cache/
