# Copy to .env and fill in. `make secrets` generates strong values.
POSTGRES_PASSWORD=change-me
ODOO_MASTER_PASSWORD=change-me

# Folder of past quotations to index (local folder, external disk, or NAS mount).
ARCHIVE_PATH=/absolute/path/to/ALL THE QUOTATIONS

# Desktop app folder holding history.db / catalog.db, for the one-time import.
LEGACY_PATH=/absolute/path/to/Qoutation-maker
