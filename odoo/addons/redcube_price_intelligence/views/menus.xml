<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_price_intelligence_root"
              name="Price Archive"
              web_icon="redcube_price_intelligence,static/description/icon.png"
              sequence="45"
              groups="group_price_archive_user"/>

    <menuitem id="menu_price_archive"
              name="Archive"
              parent="menu_price_intelligence_root"
              sequence="10"/>

    <menuitem id="menu_archive_items"
              name="Price Archive"
              parent="menu_price_archive"
              action="action_archive_item"
              sequence="10"/>

    <menuitem id="menu_archive_search"
              name="Search Archive"
              parent="menu_price_archive"
              action="action_archive_search_wizard"
              sequence="5"/>

    <menuitem id="menu_archive_index"
              name="Index Archive"
              parent="menu_price_archive"
              action="action_archive_index_wizard"
              sequence="30"
              groups="group_price_archive_manager"/>

    <menuitem id="menu_archive_sources"
              name="Source Documents"
              parent="menu_price_archive"
              action="action_archive_source"
              sequence="20"/>

    <!-- Review sits at the top level rather than buried: an unreviewed low-confidence rate is
         indistinguishable from a good one once it reaches a client's quotation. -->
    <menuitem id="menu_price_review"
              name="Review"
              parent="menu_price_intelligence_root"
              sequence="20"
              groups="group_price_archive_manager"/>

    <menuitem id="menu_archive_review_queue"
              name="Needs Review"
              parent="menu_price_review"
              action="action_archive_review_queue"
              sequence="10"/>

    <menuitem id="menu_archive_corrections"
              name="Corrections"
              parent="menu_price_review"
              action="action_archive_correction"
              sequence="20"/>

</odoo>
