<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_archive_source_list" model="ir.ui.view">
        <field name="name">redcube.archive.source.list</field>
        <field name="model">redcube.archive.source</field>
        <field name="arch" type="xml">
            <list string="Source Documents">
                <field name="name"/>
                <field name="file_type"/>
                <field name="document_date"/>
                <field name="venue"/>
                <field name="item_count" string="Lines"/>
                <field name="photo_count" string="Photos"/>
                <field name="last_indexed"/>
            </list>
        </field>
    </record>

    <record id="view_archive_source_form" model="ir.ui.view">
        <field name="name">redcube.archive.source.form</field>
        <field name="model">redcube.archive.source</field>
        <field name="arch" type="xml">
            <form string="Source Document">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="File name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="file_type"/>
                            <field name="relative_path"/>
                            <field name="document_date"/>
                        </group>
                        <group>
                            <!-- Venue belongs to the document, not the line. Editing it here
                                 is the whole point: correcting it per line meant re-typing the
                                 same value dozens of times for one job. -->
                            <field name="venue"/>
                            <field name="last_indexed" readonly="1"/>
                            <field name="content_fingerprint" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="item_ids" readonly="1">
                                <list>
                                    <field name="title"/>
                                    <field name="rate"/>
                                    <field name="uom_label"/>
                                    <field name="rate_confidence"/>
                                    <field name="needs_review"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Anything worth knowing about this document."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_archive_source" model="ir.actions.act_window">
        <field name="name">Source Documents</field>
        <field name="res_model">redcube.archive.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents indexed yet</p>
            <p>Every quotation, cost sheet and equipment list read into the archive is listed
               here with how many lines and photos came out of it — so a document that parsed
               to nothing is visible rather than silently skipped.</p>
        </field>
    </record>

    <record id="view_archive_correction_list" model="ir.ui.view">
        <field name="name">redcube.archive.correction.list</field>
        <field name="model">redcube.archive.correction</field>
        <field name="arch" type="xml">
            <list string="Corrections" editable="bottom">
                <field name="source_name"/>
                <field name="display_description"/>
                <field name="rate"/>
                <field name="uom_label"/>
                <field name="venue"/>
                <field name="corrected_field_ids" string="Pinned Fields"/>
                <field name="reviewed_by"/>
                <field name="write_date" string="Corrected On"/>
            </list>
        </field>
    </record>

    <record id="action_archive_correction" model="ir.actions.act_window">
        <field name="name">Corrections</field>
        <field name="res_model">redcube.archive.correction</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No corrections yet</p>
            <p>Fixes made in the review queue are recorded here so they survive re-indexing.
               Only the fields listed under <b>Pinned Fields</b> override what the parser
               reads — everything else re-reads from the source document each time, so a price
               change in the original spreadsheet still reaches the archive. Delete a
               correction to let its item re-parse from scratch.</p>
        </field>
    </record>

</odoo>
