[options]
; Master password. Gates database create/drop/restore from the web UI.
admin_passwd = generate-me-see-README

; Connection details live here rather than only in the HOST/USER/PASSWORD environment
; variables. The image entrypoint translates those env vars into command-line arguments, so
; anything run with `docker compose exec odoo odoo ...` bypasses them entirely and tries a
; local unix socket that does not exist in the container. Putting them in the config makes
; every invocation work the same way.
db_host = db
db_port = 5432
db_user = odoo
db_password = same-as-POSTGRES_PASSWORD-in-.env

; Custom addons are mounted at /mnt/extra-addons; the second path is the stock addon set
; that ships inside the image.
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; A single-user local install: one worker in threaded mode is plenty, and it keeps the
; Python debugger usable when developing the custom addon.
workers = 0

; The stock 120s cap is far too short for what this instance does. Re-indexing the
; historical quotation archive parses hundreds of spreadsheets and PDFs and computes
; embeddings for every line item, which runs for minutes, not seconds.
limit_time_cpu = 1800
limit_time_real = 3600

; Parsed archives and product photos push request sizes well past the default.
limit_memory_soft = 2147483648
limit_memory_hard = 2684354560

; Keep the database manager reachable while we are still setting up and reloading data.
; Worth turning off once the instance is in real use.
list_db = True

log_level = info
