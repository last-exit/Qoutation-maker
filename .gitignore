# --- Python environment / build artifacts -------------------------------------
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Local data stores --------------------------------------------------------
# chroma_db is a regenerable local index, not source: rebuild it any time with
# "Sync & Build Index" in the app. It is excluded because chroma.sqlite3 grew past
# 195 MB once photos were captured at full resolution, and GitHub hard-rejects any
# single file over 100 MB. It also holds client pricing and product photos, which
# do not belong in a shared repository.
chroma_db/
chroma_db_backup_*/

# Quotation history and PM corrections contain real client records.
history.db
history.db-wal
history.db-shm
corrections.db
corrections.db-wal
corrections.db-shm
corrections_backup_*.db
catalog.db
catalog.db-wal
catalog.db-shm

# Product photos extracted from client quotations, content-addressed by image_store.
# Regenerable by re-syncing, and they are client material either way.
images/

# Automatic database snapshots taken before every index rebuild and migration.
backups/

# Runtime log.
logs/

# The exported ONNX embedding model (~91 MB), produced by tools/export_onnx.py.
# Regenerate rather than commit: GitHub warns past 50 MB and it is derived, not source.
# Anchored to the repo root — an unanchored `models/` also matches every Odoo addon's
# models/ package, which silently dropped the addon source from the first commit.
/models/

# --- Generated output ---------------------------------------------------------
# Quotations written by the app, named after real clients.
*_Quotation_*.xlsx
*_Quotation_*.docx
*_Quotation_*.pdf
scratch/

# --- graphify local state -----------------------------------------------------
# graph.json / GRAPH_REPORT.md are committed (CLAUDE.md points contributors at them).
# These are machine-local: an AST cache that regenerates, absolute interpreter paths
# that are meaningless on another machine, and dated rebuild snapshots.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/20*/
graphify-out/wiki/

# --- Odoo deployment ----------------------------------------------------------
# Real credentials and the generated config that embeds the master password.
# The .example files next to them are tracked.
odoo/.env
odoo/config/odoo.conf
# Filestore/attachment dumps taken for local restores.
odoo/backups/

# --- Credentials --------------------------------------------------------------
# Only credentials.json.template is tracked; the real file never is.
credentials.json
token.json

# --- OS noise -----------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
~$*
