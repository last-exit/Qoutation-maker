# --- Python environment / build artifacts -------------------------------------
venv/
__pycache__/
*.py[cod]
*.egg-info/

# The Windows installer build. `build/` and `dist/` are PyInstaller's working and output
# directories; `build-venv/` is the isolated environment build_installer.bat creates so that
# nothing installed for development can leak into a shipped bundle. The finished installer
# is ~2 GB and belongs in a file transfer, not in git history.
build/
dist/
build-venv/
# The WebView2 bootstrapper is redistributable but is Microsoft's to distribute, and
# build_installer.bat downloads it on demand.
installer/redist/

# Generated from assets/red_cube_logo.png by tools/make_icon.py.
assets/app.ico

# --- Local data stores --------------------------------------------------------
# chroma_db is a regenerable local index, not source: rebuild it any time with
# "Sync & Build Index" in the app. It is excluded because chroma.sqlite3 grew past
# 195 MB once photos were captured at full resolution, and GitHub hard-rejects any
# single file over 100 MB. It also holds client pricing and product photos, which
# do not belong in a shared repository.
chroma_db/
chroma_db_backup_*/

# Quotation history and PM corrections contain real client records.
history.db
history.db-wal
history.db-shm
corrections.db
corrections.db-wal
corrections.db-shm
corrections_backup_*.db
catalog.db
catalog.db-wal
catalog.db-shm
jobs.db
jobs.db-wal
jobs.db-shm
# invoices.db was tracked, and this repository is public. It held no rows, so nothing was
# exposed — but it records what each client was billed and what they have paid, and it only
# stays empty until the app is actually used.
invoices.db
invoices.db-wal
invoices.db-shm
# Backup passphrase and destination. The passphrase must never enter version control —
# it is the only thing standing between the cloud copy and anyone who reaches the folder.
.backup_key
backup_config.json


# Product photos extracted from client quotations, content-addressed by image_store.
# Regenerable by re-syncing, and they are client material either way.
images/

# Automatic database snapshots taken before every index rebuild and migration.
backups/

# Runtime log.
logs/

# The exported ONNX embedding model (~91 MB), produced by tools/export_onnx.py.
# Regenerate rather than commit: GitHub warns past 50 MB and it is derived, not source.
# Anchored to the repo root — an unanchored `models/` also matches every Odoo addon's
# models/ package, which silently dropped the addon source from the first commit.
/models/

# --- Generated output ---------------------------------------------------------
# Quotations written by the app, named after real clients.
*_Quotation_*.xlsx
*_Quotation_*.docx
*_Quotation_*.pdf
scratch/

# Sample quotations contain real client data and pricing.
sample_quotes/

# Impeccable review artefacts — local tooling, not source.
.impeccable/

# --- graphify local state -----------------------------------------------------
# graph.json / GRAPH_REPORT.md are committed (CLAUDE.md points contributors at them).
# These are machine-local: an AST cache that regenerates, absolute interpreter paths
# that are meaningless on another machine, and dated rebuild snapshots.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/20*/
graphify-out/wiki/

# --- Credentials --------------------------------------------------------------
# Only credentials.json.template is tracked; the real file never is.
credentials.json
token.json

# --- OS noise -----------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
~$*
